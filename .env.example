DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/portfolio
DATABASE_USERNAME=portfolio
DATABASE_PASSWORD=
SERVER_ADDRESS=127.0.0.1
PORT=8080
SESSION_COOKIE_SECURE=false
MEDIA_DIRECTORY=./uploads
